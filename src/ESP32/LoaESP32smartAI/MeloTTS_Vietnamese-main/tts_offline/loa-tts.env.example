# Mẫu cho /etc/loa-tts.env trên PI 5 — file thật KHÔNG commit (chứa mật khẩu).
#
# Cài:
#   sudo cp tts_offline/loa-tts.env.example /etc/loa-tts.env
#   sudo nano /etc/loa-tts.env        # điền mật khẩu thật
#   sudo chmod 600 /etc/loa-tts.env   # chỉ root đọc được
#
# Cú pháp systemd EnvironmentFile: KHÔNG có "export", KHÔNG có nháy quanh giá trị,
# không có khoảng trắng quanh dấu "=".

MQTT_HOST=xxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=smartparking
MQTT_PASS=doi-mat-khau-nay

# TLS: 1 = cổng 8883 (HiveMQ Cloud chỉ nhận TLS). 0 = 1883 trần, chỉ để test broker LAN.
MQTT_TLS=1

# Cổng HTTP để ESP32 tải WAV về (phải cho ESP32 truy cập trong LAN).
LOA_HTTP_PORT=8080

# Để trống = Pi tự đoán IP LAN. Điền tay nếu Pi có nhiều card mạng và đoán sai
# (ví dụ máy có cả Wi-Fi lẫn Ethernet, hoặc có Tailscale).
LOA_HTTP_HOST=

# Thư mục chứa WAV đã render. Mặc định ~/.cache/loa_tts.
# LOA_WAV_DIR=/home/pi/.cache/loa_tts
