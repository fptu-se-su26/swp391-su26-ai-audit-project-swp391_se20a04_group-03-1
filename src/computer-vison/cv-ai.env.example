# Mẫu cho /etc/cv-ai.env trên PI 5.
#
# Cài:
#   sudo cp cv-ai.env.example /etc/cv-ai.env
#   sudo nano /etc/cv-ai.env
#
# Cú pháp systemd EnvironmentFile: KHÔNG "export", KHÔNG nháy, không khoảng trắng quanh "=".
# Mọi biến đều CÓ MẶC ĐỊNH trong src/config.py — chỉ đặt cái nào cần đổi.

# Backend nhận sự kiện quét biển số. Mặc định đã đúng, để đây cho dễ đổi khi test local.
BACKEND_URL=https://api.datnotes.click/api/scan

# Cổng Flask phục vụ /video_feed, /status cho frontend.
FLASK_PORT=5001
FLASK_HOST=0.0.0.0

# OCR: rapidocr (nhẹ, ONNXRuntime — khuyến nghị Pi 5) | easyocr (nặng, cần torch).
OCR_ENGINE=rapidocr

# Chạy detect mỗi N frame. Tăng 2~3 nếu NPU quá tải / muốn mượt hơn.
DETECT_INTERVAL=1

# Ngưỡng tin cậy.
DETECTION_CONFIDENCE_THRESHOLD=0.5
OCR_CONFIDENCE_THRESHOLD=0.4

# Giây chờ trước khi gửi lại CÙNG một biển số lên backend (chống gửi trùng).
COOLDOWN_PERIOD=5.0

# Model: để trống = tự chọn .hef (Hailo NPU) > _ncnn_model > .pt. Chỉ đặt khi muốn ép.
# YOLO_PLATE_MODEL_PATH=
# YOLO_CONTAINER_MODEL_PATH=
