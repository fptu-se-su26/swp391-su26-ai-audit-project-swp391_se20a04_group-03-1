{
  "expo": {
    "name": "LogiPort",
    "slug": "frontend_mobile-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon-icon.png",
    "scheme": "frontendmobileexpo",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/favicon-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/favicon-fg.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kenleo.frontend_mobileexpo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06090c",
          "image": "./assets/images/favicon-fg.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6cb2d86c-b409-4d66-98ad-205df0f5864c"
      }
    },
    "owner": "kenleo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6cb2d86c-b409-4d66-98ad-205df0f5864c"
    }
  }
}
