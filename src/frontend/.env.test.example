# Template biến môi trường TEST cho Playwright E2E (frontend).
# Cách dùng: copy thành `.env.test` rồi điền tài khoản demo của bạn.
#   Windows PowerShell:  Copy-Item .env.test.example .env.test
#   Bash:                cp .env.test.example .env.test

# URL gốc của app khi chạy E2E.
E2E_BASE_URL="http://localhost:3000"

# URL backend API (đăng nhập lấy cookie trước khi test trang cần auth).
E2E_API_URL="http://localhost:4000/api"

# --- Tài khoản chạy BACKEND THẬT (login.spec.ts, drivers.pom.spec.ts) ---

# Tài khoản admin hợp lệ (SUPER_ADMIN) — điền của bạn, KHÔNG commit .env.test thật.
E2E_ADMIN_EMAIL="admin@example.com"
E2E_ADMIN_PASSWORD="your-demo-password"

# Mật khẩu sai để test đăng nhập thất bại.
E2E_WRONG_PASSWORD="wrongpassword"

# Email không tồn tại trên hệ thống.
E2E_NONEXISTENT_EMAIL="nonexistent.admin@logiport.com"

# Tài khoản fixture (inactive/deleted) cần tồn tại sẵn trong DB (dùng chung 1 mật khẩu).
E2E_SEED_PASSWORD="password123"
E2E_INACTIVE_EMAIL="inactive@logiport.com"
E2E_DELETED_EMAIL="deleted@logiport.com"

# --- Tài khoản cho test CÓ MOCK backend (giá trị bất kỳ) ---
E2E_MOCK_EMAIL="admin@example.com"
E2E_MOCK_PASSWORD="123456"
