# Template biến môi trường TEST cho backend (Jest).
# Cách dùng: copy file này thành `.env.test` rồi điền giá trị.
#   Windows PowerShell:  Copy-Item .env.test.example .env.test
#   Bash:                cp .env.test.example .env.test
#
# LƯU Ý: chỉ dùng giá trị GIẢ cho test, KHÔNG đặt secret thật.
# Test dùng mongodb-memory-server nên DATABASE để trống; Redis đã mock trong jest.setup.ts.

NODE_ENV="test"
DATABASE=""
JWT_SECRET="test-jwt-secret-logiport"
FRONTEND_URL="http://localhost:3000"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="dummy"
EMAIL_USER="test@logiport.local"
EMAIL_APP="test-app-password"
CLOUDINARY_NAME="test"
CLOUDINARY_APIKEY="test"
CLOUDINARY_APISECRET="test"

# Cờ để test khẳng định .env.test đã được nạp.
TEST_ENV_NAME="logiport-test"
