        {
          "name": "Create Yard",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomInt = Math.floor(Math.random() * 1000000);",
                  "pm.variables.set(\"randomCameraIp\", \"rtsp://192.168.1.\" + randomInt + \"/stream\");"
                ],
                "type": "javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Create yard successful\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(\"success\");",
                  "});"
                ],
                "type": "javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Bãi đỗ Khu A\",\n    \"cameraIp\": \"{{randomCameraIp}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/yards/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "yards",
                "create"
              ]
            }
          },
          "response": []
